local function getWeaponInfo(tool)
    if not tool or not tool:IsA("Tool") then return nil end
    local key = generateUniqueKey(tool)
    return WeaponDB[key] or {
        Name = tool.Name,
        Rarity = "Default",
        ToolName = tool.Name,
        Key = key
    }
end

