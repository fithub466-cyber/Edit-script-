local function refreshInspectorList()
    for _, child in ipairs(InspectorScroll:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local pCard = Instance.new("Frame", InspectorScroll)
            pCard.Size = UDim2.new(1, 0, 0, 65)
            pCard.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
            Instance.new("UICorner", pCard).CornerRadius = UDim.new(0, 6)
            local cardStroke = Instance.new("UIStroke", pCard)
            cardStroke.Color = Color3.fromRGB(50, 50, 50)
            cardStroke.Thickness = 1
            
            local nameLbl = Instance.new("TextLabel", pCard)
            nameLbl.BackgroundTransparency = 1
            nameLbl.Position = UDim2.new(0.03, 0, 0.05, 0)
            nameLbl.Size = UDim2.new(0.94, 0, 0, 20)
            nameLbl.Font = Enum.Font.GothamBold
            nameLbl.TextSize = 13
            nameLbl.Text = player.Name
            nameLbl.TextColor3 = Color3.fromRGB(150, 200, 255)
            nameLbl.TextXAlignment = Enum.TextXAlignment.Left
            
            local itemsLbl = Instance.new("TextLabel", pCard)
            itemsLbl.BackgroundTransparency = 1
            itemsLbl.Position = UDim2.new(0.03, 0, 0.35, 0)
            itemsLbl.Size = UDim2.new(0.94, 0, 0, 35)
            itemsLbl.Font = Enum.Font.Gotham
            itemsLbl.TextSize = 11
            itemsLbl.TextColor3 = Color3.fromRGB(200, 200, 200)
            itemsLbl.TextXAlignment = Enum.TextXAlignment.Left
            itemsLbl.TextYAlignment = Enum.TextYAlignment.Top
            itemsLbl.TextWrapped = true
            
            local foundItems = {}
            local function collectTools(folder)
                if not folder then return end
                for _, tool in ipairs(folder:GetChildren()) do
                    if tool:IsA("Tool") and tool.Name ~= "Fists" then
                        local info = getWeaponInfo(tool)
                        if info then
                            local rLower = string.lower(tostring(info.Rarity))
                            if not (HideCommonItems and (rLower == "common" or rLower == "default")) then
                                table.insert(foundItems, info.Name)
                            end
                        end
                    end
                end
            end
            
            if player.Character then
                collectTools(player.Character)
                local bp = player:FindFirstChild("Backpack")
                if bp then collectTools(bp) end
            end
            
            if #foundItems > 0 then
                itemsLbl.Text = table.concat(foundItems, ", ")
            else
                itemsLbl.Text = "Items: (ไม่มีไอเทมเกรดสูง)"
            end
        end
    end
    InspectorScroll.CanvasSize = UDim2.new(0, 0, 0, InspectorListLayout.AbsoluteContentSize.Y)
end

