local lastAlertData = {} 
local COOLDOWN_TIME = 600

local function checkPlayerLegendItems(player)
    if not player or not player.Character then return end
    
    local legendItems = {}
    local function scanFolder(folder)
        if not folder then return end
        for _, tool in ipairs(folder:GetChildren()) do
            if tool:IsA("Tool") and tool.Name ~= "Fists" then
                local info = getWeaponInfo(tool)
                if info then
                    local rLower = string.lower(tostring(info.Rarity))
                    if rLower == "legendary" then
                        table.insert(legendItems, info.Name)
                    end
                end
            end
        end
    end
    
    scanFolder(player.Character)
    local backpack = player:FindFirstChild("Backpack")
    if backpack then scanFolder(backpack) end
    
    if #legendItems > 0 then
        table.sort(legendItems)
        local itemsSignature = table.concat(legendItems, "_")
        local currentTime = tick()
        
        local playerData = lastAlertData[player.UserId]
        if playerData then
            if playerData.signature == itemsSignature and (currentTime - playerData.time < COOLDOWN_TIME) then
                return
            end
        end
        
        lastAlertData[player.UserId] = {
            signature = itemsSignature,
            time = currentTime
        }
        
        local fields = {
            {
                ["name"] = "👤 ชื่อผู้เล่น",
                ["value"] = string.format("%s (ID: %d)", player.Name, player.UserId),
                ["inline"] = false
            },
            {
                ["name"] = "⚔️ ไอเทมที่พบใน Inventory",
                ["value"] = table.concat(legendItems, ", "),
                ["inline"] = false
            },
            {
                ["name"] = "🌐 Job ID (ไอดีเซิร์ฟเวอร์)",
                ["value"] = string.format("`%s`", game.JobId),
                ["inline"] = false
            }
        }
        sendDiscordEmbed("⚠️ พบผู้เล่นถือไอเทมระดับ Legend!", 16761035, fields)
    end
end

local function createPlayerESP(player)
    if player == LocalPlayer or ESPBillboards[player] then return end

    local headBillboard = Instance.new("BillboardGui")
