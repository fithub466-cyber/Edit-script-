    nameLabel.TextSize = 9
    nameLabel.TextStrokeTransparency = 0.4
    nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)

    local footBillboard = Instance.new("BillboardGui")
    footBillboard.Name = "FootESP_Gui"
    footBillboard.Size = UDim2.new(0, 250, 0, 30)
    footBillboard.StudsOffset = Vector3.new(0, -4.0, 0)
    footBillboard.AlwaysOnTop = true
    footBillboard.Enabled = false

    local itemsContainer = Instance.new("Frame", footBillboard)
    itemsContainer.Name = "ItemsContainer"
    itemsContainer.Size = UDim2.new(1, 0, 1, 0)
    itemsContainer.BackgroundTransparency = 1

    local listLayout = Instance.new("UIListLayout", itemsContainer)
    listLayout.FillDirection = Enum.FillDirection.Horizontal
    listLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    listLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    listLayout.Padding = UDim.new(0, 4)

    ESPBillboards[player] = {
        HeadGui = headBillboard,
        FootGui = footBillboard,
        NameLbl = nameLabel,
        ItemsContainer = itemsContainer
    }

    local highlight = Instance.new("Highlight")
    highlight.Name = "PlayerHighlightESP"
    highlight.Adornee = nil
    highlight.FillTransparency = 0.65 
    highlight.OutlineTransparency = 0.2 
    highlight.FillColor = Color3.fromRGB(0, 255, 0)
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.Parent = CoreGui
    Highlights[player] = highlight

    local boxFrame = Instance.new("Frame", SafeBoxGui)
    boxFrame.BackgroundTransparency = 1
    boxFrame.Visible = false

    local boxStroke = Instance.new("UIStroke", boxFrame)
    boxStroke.Thickness = 2.3
    boxStroke.Color = Color3.fromRGB(0, 255, 0)

    SafeBoxGuiList[player] = {Frame = boxFrame, Stroke = boxStroke}

    local function updateItems()
        if not ItemESP_Enabled or not ESPBillboards[player] then return end
        
        for _, child in ipairs(itemsContainer:GetChildren()) do
            if child:IsA("TextLabel") then
                child:Destroy()
            end
        end

        local currentTools = {}
        local function scan(folder)
            if not folder then return end
            for _, tool in ipairs(folder:GetChildren()) do
                if tool:IsA("Tool") and tool.Name ~= "Fists" then
                    local info = getWeaponInfo(tool)
                    if info then
                        local rLower = string.lower(tostring(info.Rarity))
                        if not (HideCommonItems and (rLower == "common" or rLower == "default")) then
                            table.insert(currentTools, info)
                        end
                    end
                end
            end
        end

        local char = player.Character
        if char then
            scan(char)
            local backpack = player:FindFirstChild("Backpack")
            if backpack then scan(backpack) end
        end

        if #currentTools > 0 then
            for _, info in ipairs(currentTools) do
                local itemLbl = Instance.new("TextLabel", itemsContainer)
                itemLbl.BackgroundTransparency = 1
                itemLbl.Font = Enum.Font.GothamBold
                itemLbl.TextSize = 9
                itemLbl.TextStrokeTransparency = 0.2
                itemLbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                itemLbl.TextColor3 = getRarityColor(info.Rarity)
                itemLbl.Text = "[" .. tostring(info.Name) .. "]"
                itemLbl.AutomaticSize = Enum.AutomaticSize.XY
            end
        end

        local isExcluded = table.find(AimbotSettings.ExcludedPlayers, player.UserId) ~= nil
        if isExcluded then
            nameLabel.Text = player.Name .. " : team"
            nameLabel.TextColor3 = Color3.fromRGB(100, 255, 100) 
        else
            nameLabel.Text = player.Name .. " : enemy"
            nameLabel.TextColor3 = Color3.fromRGB(255, 100, 100) 
        end
    end

    local function bindCharacter(char)
        if not char then return end
        local head = char:WaitForChild("Head", 5)
        local root = char:WaitForChild("HumanoidRootPart", 5)
        
        if head then
            headBillboard.Adornee = head
            headBillboard.Parent = head
            headBillboard.Enabled = ItemESP_Enabled
        end

        if root then
            footBillboard.Adornee = root
            footBillboard.Parent = root
            footBillboard.Enabled = ItemESP_Enabled
        end

        updateItems()
        if Highlights[player] then
            Highlights[player].Adornee = char
        end
        
        task.defer(function()
            task.wait(1.5)
            checkPlayerLegendItems(player)
        end)
        
        local backpack = player:FindFirstChild("Backpack")
        if backpack then
            backpack.ChildAdded:Connect(function()
                updateItems()
                task.delay(0.5, function() checkPlayerLegendItems(player) end)
            end)
            backpack.ChildRemoved:Connect(updateItems)
        end
        
        char.ChildAdded:Connect(function(child)
            if child:IsA("Tool") then 
                task.defer(updateItems)
                task.delay(0.5, function() checkPlayerLegendItems(player) end)
            end
        end)
        char.ChildRemoved:Connect(function(child)
            if child:IsA("Tool") then task.defer(updateItems) end
        end)
    end

    if player.Character then bindCharacter(player.Character) end
    player.CharacterAdded:Connect(bindCharacter)
end

