local function matches(item)
    if item.rarity ~= "Legendary" then return false end
    local sv = string.lower(tostring(item.server or ""))
    if st.sv ~= "All" then
        if st.sv == "plus+" then
            if not sv:find("^plus%+") then return false end
        else
            if not sv:find("^" .. st.sv) then return false end
        end
    end
    if st.q ~= "" then
        if not string.lower(item.name):find(string.lower(st.q), 1, true) then return false end
    end
    return true
end

