--========== STATUS ==========
local function updStatus()
    local map = {
        live       = "🟢 เชื่อมต่อสด",
        fallback   = "🟡 โหมดสำรอง",
        connecting = "🔵 กำลังเชื่อมต่อ...",
    }
    statusLabel.Text = map[st.status] or map.connecting
end

--========== WEBSOCKET ==========
local function getWS()
    if WebSocket and WebSocket.connect then return WebSocket.connect end
    if syn and syn.websocket and syn.websocket.connect then return syn.websocket.connect end
    if websocket and websocket.connect then return websocket.connect end
    return nil
end

local function normalize(packet)
    local d = packet and packet.data
    if not d then return {} end
    local attrs, cols = d.attributes, d.columns
    if type(attrs) ~= "table" or type(cols) ~= "table" then return {} end
    local out = {}
    for _, row in ipairs(cols) do
        local o = {}
        for i, k in ipairs(attrs) do o[k] = row[i] end
        if o.jobId and o.item then
            out[#out + 1] = {
                name        = o.item,
                rarity      = o.rarity or "Epic",
                players     = o.players,
                target      = o.target,
                server      = o.server,
                createdTime = o.createdTime or (os.time() * 1000),
                jobId       = o.jobId,
            }
        end
    end
    return out
end

local function merge(newItems, replace)
    if replace then
        items = newItems
        return
    end
    local ex = {}
    for _, it in ipairs(items) do ex[it.jobId] = true end
    for i = #newItems, 1, -1 do
        local it = newItems[i]
        if not ex[it.jobId] then
            table.insert(items, 1, it)
            ex[it.jobId] = true
        end
    end
    while #items > MAX_ITEMS do table.remove(items) end
end

local function onMsg(raw)
    local ok, packet = pcall(function()
        if type(raw) == "string" then
            local s = string.find(raw, "{")
            return HttpService:JSONDecode(s and string.sub(raw, s) or raw)
        end
        return raw
    end)
    if not ok or type(packet) ~= "table" then return end

    local newItems = normalize(packet)
    if #newItems == 0 then return end

    if not loaded then
        for _, it in ipairs(newItems) do known[it.jobId] = true end
        loaded = true
    else
        for _, it in ipairs(newItems) do
            if it.rarity == "Legendary" and not known[it.jobId] then
                known[it.jobId] = true
                totalFound = totalFound + 1
                if st.snd then ding() end
                statusLabel.Text = "⭐ ใหม่: " .. it.name
                statLog.Text = "🆕 ล่าสุด: " .. it.name .. " · " .. timeAgo(it.createdTime)
                tween(statusLabel, 0.15, { TextColor3 = C.CYAN })
                task.delay(1.5, function()
                    tween(statusLabel, 0.3, { TextColor3 = C.MUTED })
                end)
            end
        end
    end

    if packet.type == "initial" then
        merge(newItems, true)
    else
        merge(newItems, false)
    end
    st.status = "live"
    updStatus()
    requestRebuild()
end

function connectLive()
    local g = getWS()
    if not g then
        st.status = "fallback"; updStatus(); return
    end
    local ok, ws = pcall(g, WS_URL)
    if not ok or not ws then
        st.status = "fallback"; updStatus(); return
    end
    st.socket = ws
    st.status = "live"
    updStatus()
    if ws.OnMessage then pcall(function() ws.OnMessage:Connect(onMsg) end) end
    if ws.OnTextMessage then pcall(function() ws.OnTextMessage:Connect(onMsg) end) end
    if ws.OnError then pcall(function()
        ws.OnError:Connect(function() st.status = "fallback"; updStatus() end)
    end) end
    if ws.OnClose then pcall(function()
        ws.OnClose:Connect(function()
            st.status = "fallback"
            updStatus()
            task.wait(5)
            connectLive()
        end)
    end) end
end

