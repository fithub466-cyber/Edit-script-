-- ==========================================
-- HUMAN-LIKE LOGIC (ระบบจำลองการกดแบบมนุษย์)
-- ==========================================
local IsRunning = false
local IsExecutingE = false

local function GetTargetPrompt()
    local closestPrompt = nil
    local closestPart = nil
    local shortestDistance = math.huge
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local objText = tostring(obj.ObjectText or "")
            local actText = tostring(obj.ActionText or "")
            local parentName = obj.Parent and tostring(obj.Parent.Name or "") or ""
            
            local isMatch = string.find(objText, "รับเงิน") 
                or string.find(actText, "รับเงิน") 
                or string.find(parentName, "รับเงิน")
            
            if isMatch and obj.Enabled then
                local parentPart = obj:FindFirstAncestorWhichIsA("BasePart") or obj.Parent
                if parentPart and parentPart:IsA("BasePart") then
                    local dist = (RootPart.Position - parentPart.Position).Magnitude
                    if dist < shortestDistance then
                        shortestDistance = dist
                        closestPrompt = obj
                        closestPart = parentPart
                    end
                end
            end
        end
    end
    return closestPrompt, closestPart
end

-- ฟังก์ชันจำลองมนุษย์กดปุ่ม E
local function SimulateHumanKeyPress(prompt)
    if IsExecutingE then return end
    IsExecutingE = true
    
    StatusLabel.Text = "สถานะ: กำลังจำลองการกด E แบบมนุษย์..."
    StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
    
    -- 1. หน่วงเวลาการตอบสนองของมนุษย์ (Human Reaction Time) ก่อนเริ่มกด
    local humanReaction = math.random(15, 35) / 100 -- 0.15 ถึง 0.35 วินาที
    task.wait(humanReaction)
    
    -- 2. จำลองการกดปุ่ม E ลงไป (Key Down)
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
    
    -- 3. คำนวณระยะเวลาถือค้างปุ่ม ตามค่า HoldDuration ของ ProximityPrompt นั้นๆ
    local holdDuration = prompt.HoldDuration or 0.5
    if holdDuration < 0.1 then 
        holdDuration = 0.2 
    end
    
    -- สุ่มเวลาปล่อยปุ่มให้เหลื่อมจากเวลาค้างจริงเล็กน้อย (Human Imperfection)
    local humanHoldOffset = math.random(8, 18) / 100 -- สุ่มค้างเกินมาอีกนิดหน่อย
    task.wait(holdDuration + humanHoldOffset)
    
    -- 4. จำลองการปล่อยปุ่ม E (Key Up)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    
    StatusLabel.Text = "สถานะ: กด E สำเร็จแล้ว!"
    StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 120)
    
    -- 5. ระยะเวลาพักก่อนกดครั้งถัดไป (ป้องกันสแปมที่ถี่เกินไป)
    local coolDown = math.random(4, 8) / 10
    task.wait(coolDown)
    
    IsExecutingE = false
end

-- Main Loop
task.spawn(function()
    while true do
        task.wait(0.1)
        if IsRunning and Character and RootPart and Humanoid then
            local prompt, targetPart = GetTargetPrompt()
            
            if prompt and targetPart then
                local distance = (RootPart.Position - targetPart.Position).Magnitude
                
                -- ระยะเข้าใกล้ปุ่มที่เหมาะสม
                local stopDistance = prompt.MaxActivationDistance or 5.0
                if stopDistance > 3.5 then
                    stopDistance = 3.0
                end
                
                if distance > stopDistance then
                    StatusLabel.Text = "สถานะ: กำลังเดินเข้าใกล้จุดรับเงิน..."
                    StatusLabel.TextColor3 = Color3.fromRGB(255, 180, 0)
                    Humanoid:MoveTo(targetPart.Position)
                else
                    -- หยุดเดินแล้วทำการกดปุ่มแบบมนุษย์
                    Humanoid:MoveTo(RootPart.Position) -- หยุดเดินให้อยู่นิ่งๆ ก่อนกด
                    SimulateHumanKeyPress(prompt)
                end
            else
                StatusLabel.Text = "สถานะ: ไม่พบปุ่ม 'รับเงิน'..."
                StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
            end
        end
    end
end)

