-- ข้อมูลวินิจฉัยพื้นฐานเท่านั้น
local function buildDump()
    local data = {
        meta = {
            gameId = game.GameId,
            placeId = game.PlaceId,
            placeVersion = game.PlaceVersion,
            clientTime = os.time(),
            isStudio = RunService:IsStudio(),
            isClient = RunService:IsClient()
        },
        services = {}
    }

    local names = {
        "Workspace",
        "ReplicatedStorage",
        "ReplicatedFirst",
        "Lighting",
        "SoundService",
        "StarterGui",
        "StarterPack",
        "StarterPlayer",
        "Teams"
    }

    for _, name in ipairs(names) do
        local ok, result = pcall(function()
            local service = game:GetService(name)
            local children = {}

            for _, child in ipairs(service:GetChildren()) do
                table.insert(children, {
                    name = child.Name,
                    className = child.ClassName
                })
            end

            return {
                childCount = #children,
                children = children
            }
        end)

        data.services[name] = ok and result or {
            error = "Unable to read service"
        }
    end

    return data
end

local busy = false

start.Activated:Connect(function()
    if busy then return end
    busy = true
    start.Text = "กำลังดำเนินการ..."
    start.BackgroundColor3 = Color3.fromRGB(70, 78, 140)
    setStatus("กำลังสร้างข้อมูล", Color3.fromRGB(240, 190, 80))

    local ok, result = pcall(buildDump)
    if not ok then
        setStatus("สร้างข้อมูลไม่สำเร็จ", Color3.fromRGB(240, 90, 90))
        info.Text = "เกิดข้อผิดพลาด\n" .. tostring(result)
        busy = false
        start.Text = "ลองอีกครั้ง"
        start.BackgroundColor3 = Color3.fromRGB(89, 105, 230)
        return
    end

    local encodedOk, json = pcall(function()
        return HttpService:JSONEncode(result)
    end)

    if not encodedOk then
        setStatus("แปลง JSON ไม่สำเร็จ", Color3.fromRGB(240, 90, 90))
        info.Text = "ไม่สามารถสร้าง JSON ได้"
        busy = false
        start.Text = "ลองอีกครั้ง"
        start.BackgroundColor3 = Color3.fromRGB(89, 105, 230)
        return
    end

    info.Text = "ข้อมูลพร้อมแล้ว\nขนาด: " .. #json .. " bytes"

    if API_KEY == "$2a$10$WD/CrFD4Q5/iZ4qunRck5eL/cVrqGER3MFM42vOEN3tPHk.Lmpk9O" then
        setStatus("ต้องตั้งค่า API Key", Color3.fromRGB(240, 190, 80))
        info.Text = info.Text .. "\nยังไม่ได้ส่งข้อมูล"
    else
        local send = getRequestFunction()

        if not send then
            setStatus("ไม่พบ HTTP request", Color3.fromRGB(240, 90, 90))
            info.Text = info.Text .. "\nExecutor ไม่รองรับ request ที่รู้จัก"
        else
            local requestOk, response = pcall(function()
                return send({
                    Url = API_URL,
                    Method = "PUT",
                    Headers = {
                        ["Content-Type"] = "application/json",
                        ["X-Master-Key"] = API_KEY
                    },
                    Body = json
                })
            end)

            if requestOk then
                local code = response.StatusCode or response.Status or 0
                if code >= 200 and code < 300 then
                    setStatus("ส่งข้อมูลสำเร็จ", Color3.fromRGB(70, 210, 145))
                    info.Text = "สถานะ HTTP: " .. code .. "\nขนาด: " .. #json .. " bytes"
                else
                    setStatus("ส่งไม่สำเร็จ", Color3.fromRGB(240, 90, 90))
                    info.Text = "สถานะ HTTP: " .. code .. "\nตรวจสอบ Bin และสิทธิ์ API"
                end
            else
                setStatus("คำขอล้มเหลว", Color3.fromRGB(240, 90, 90))
                info.Text = "ส่งคำขอไม่ได้\nตรวจสอบการรองรับ HTTP"
            end
        end
    end

    busy = false
    start.Text = "เก็บข้อมูลและส่ง"
    start.BackgroundColor3 = Color3.fromRGB(89, 105, 230)
end)

