        if tool:IsA("Tool") then
            if not filter or string.find(string.lower(tool.Name), string.lower(filter)) then
                local btn = Instance.new("TextButton", listScroll)
                btn.Size = UDim2.new(1, -10, 0, 35); btn.Text = tool.Name; btn.BackgroundColor3 = selectedTools[tool.Name] and Color3.fromRGB(0, 150, 80) or Color3.fromRGB(40, 40, 40); btn.TextColor3 = Color3.new(1,1,1); Instance.new("UICorner", btn)
                btn.MouseButton1Click:Connect(function()
                    selectedTools[tool.Name] = not selectedTools[tool.Name]
                    btn.BackgroundColor3 = selectedTools[tool.Name] and Color3.fromRGB(0, 150, 80) or Color3.fromRGB(40, 40, 40)
                end)
            end
        end
    end
end
