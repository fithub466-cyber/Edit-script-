-- // --- ฟังก์ชันจัดการค่าปืน --- // --
local function modifyGun(t)
    if not t:FindFirstChild("Setting") then return end
    local config = t.Setting:FindFirstChildOfClass("ModuleScript")
    if config then
        pcall(function()
            local h = require(config)
            if not originalStats[t.Name] then
                originalStats[t.Name] = {}
                for k, v in pairs(h) do originalStats[t.Name][k] = v end
            end
            
            local val = tonumber(inputs.Ammo.Text) or 999999
            h["Ammo"] = val
            h["MaxAmmo"] = val
            h["AmmoPerMag"] = val
            h["BaseDamage"] = tonumber(inputs.Damage.Text) or 99999
            h["ReloadTime"] = tonumber(inputs.ReloadSpeed.Text) or 0.01
            h["Spread"] = tonumber(inputs.Spread.Text) or 0.1 -- 🎯 ใช้ค่าจากช่องกรอก
            h["LimitedAmmoEnabled"] = false
            h["Recoil"] = 0
            h["Auto"] = true

            if minigunEnabled then
                h["FireRate"] = 0.0001; h["BulletPerShot"] = 10
            else
                h["FireRate"] = tonumber(inputs.FireRate.Text) or 0.02
                h["BulletPerShot"] = 1
            end

            h["ExplosiveEnabled"] = explosiveEnabled; h["Explosive"] = explosiveEnabled; h["ExplosionRadius"] = tonumber(inputs.Radius.Text) or 15
        end)
    end
end

-- สวิตช์
local function createTog(name, y, callback)
    local btn = Instance.new("TextButton", settingsFrame)
    btn.Size = UDim2.new(1,0,0,35); btn.Position = UDim2.new(0,0,0,y); btn.Text = name .. ": ปิด"; btn.BackgroundColor3 = Color3.fromRGB(150,0,0); btn.TextColor3 = Color3.new(1,1,1); btn.Font = Enum.Font.GothamBold; Instance.new("UICorner", btn)
    btn.MouseButton1Click:Connect(function()
        local s = callback()
        btn.Text = name .. (s and ": เปิด" or ": ปิด")
        btn.BackgroundColor3 = s and Color3.fromRGB(0, 150, 80) or Color3.fromRGB(150, 0, 0)
    end)
end

